{
  "name": "hematology-flashcards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "فلش‌کارت هماتولوژی — مرور تصویری یافته‌های مورفولوژیک خون",
  "scripts": {
    "predev": "npm run generate:data",
    "dev": "vite",
    "prebuild": "npm run generate:data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:data": "node scripts/generate-catalog.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
